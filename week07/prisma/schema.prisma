// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model User {
  id            BigInt   @id @map("userId") @default(autoincrement())
  email         String   @unique(map: "email") @db.VarChar(255)
  name          String   @db.VarChar(100)
  gender        String   @db.VarChar(15)
  birth         DateTime? @db.Date
  address       String   @db.VarChar(255)
  detailAddress String?  @db.VarChar(255)
  phoneNumber   String   @db.VarChar(15)


  userFavorCategories UserFavorCategory[]
  userMissions UserMission[] //UserMission과의 관계 정의
  reviews Review[]

  @@map("user")
}

model FoodCategory {
  id   BigInt @id @map("foodCategoryId") @default(autoincrement())
  name String @map("foodCategoryName") @db.VarChar(100)

  userFavorCategories UserFavorCategory[]

  @@map("foodcategory")
}

model UserFavorCategory {
  id             BigInt       @id @map("userFavorCategoryId") @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id])
  userId         BigInt       
  foodCategory   FoodCategory @relation(fields: [foodCategoryId], references: [id])
  foodCategoryId BigInt       

  @@index([foodCategoryId], map: "f_category_id")
  @@index([userId], map: "user_id")
  @@map("userfavorcategory")
}

model Mission {
  id           BigInt    @id @map("missionId") @default(autoincrement())
  store        Store     @relation(fields: [storeId], references: [id])
  storeId      BigInt    
  missionSpec  String    @db.Text

  userMissions UserMission[] //UserMission과의 관꼐 정의

  @@index([storeId], map: "m_store_id")
  @@map("mission")
  

  // reward, deadlind
}

model UserMission {
  id           BigInt   @id @map("userMissionId") @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id])
  userId       BigInt
  mission      Mission  @relation(fields: [missionId], references: [id])
  missionId    BigInt 
  status       String   @db.VarChar(15)

  @@index([missionId], map: "m_id")
  @@index([userId], map: "um_user_id")
  @@map("usermission")

}

model Store {
  id          BigInt  @id @map("storeId") @default(autoincrement())
  region      Region  @relation(fields: [regionId], references: [id])
  regionId    BigInt  
  name        String  @map("storeName") @db.VarChar(50)
  address     String  @db.VarChar(50)
  //score

  missions Mission[]
  reviews Review[]
  @@index([regionId], map: "r_id")
  @@map("store")

}

model Region {
  id         BigInt   @id @map("regionId") @default(autoincrement())
  name       String   @db.VarChar(155) @map("regionName")

  stores Store[]
}

model Review {
  id         BigInt  @id  @map("reviewId") @default(autoincrement())
  user       User    @relation(fields: [userId], references: [id])
  userId     BigInt
  store      Store   @relation(fields: [storeId], references: [id])
  storeId    BigInt  
  body       String  @db.Text
  //score
}
