// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model User {
  id            Int      @id @map("userId") @default(autoincrement())
  email         String   @unique(map: "email") @db.VarChar(255)
  name          String   @db.VarChar(100)
  gender        String   @db.VarChar(15)
  birth         DateTime? @db.Date
  address       String   @db.VarChar(255)
  detailAddress String?  @db.VarChar(255)
  phoneNumber   String   @db.VarChar(15)

  userFavorCategories UserFavorCategory[]
  userMissions UserMission[] //UserMission과의 관계 정의
  reviews Review[]

  @@map("user")
}

model FoodCategory {
  id   Int @id @map("foodCategoryId") @default(autoincrement())
  name String @map("foodCategoryName") @db.VarChar(100)

  userFavorCategories UserFavorCategory[]

  @@map("foodcategory")
}

model UserFavorCategory {
  id             Int       @id @map("userFavorCategoryId") @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id])
  userId         Int       
  foodCategory   FoodCategory @relation(fields: [foodCategoryId], references: [id])
  foodCategoryId Int       

  @@index([foodCategoryId], map: "f_category_id")
  @@index([userId], map: "user_id")
  @@map("userfavorcategory")
}

model Mission {
  id           Int    @id @map("missionId") @default(autoincrement())
  store        Store     @relation(fields: [storeId], references: [id])
  storeId      Int    
  missionSpec  String    @db.Text

  userMissions UserMission[] //UserMission과의 관꼐 정의

  @@index([storeId], map: "m_store_id")
  @@map("mission")
  

  // reward, deadlind
}

model UserMission {
  id           Int   @id @map("userMissionId") @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int
  mission      Mission  @relation(fields: [missionId], references: [id])
  missionId    Int 
  status       String   @db.VarChar(15)

  @@index([missionId], map: "m_id")
  @@index([userId], map: "um_user_id")
  @@map("usermission")

}

model Store {
  id          Int  @id @map("storeId") @default(autoincrement())
  region      Region  @relation(fields: [regionId], references: [id])
  regionId    Int  
  name        String  @map("storeName") @db.VarChar(50)
  address     String  @db.VarChar(50)
  //score

  missions Mission[]
  reviews Review[]
  @@index([regionId], map: "r_id")
  @@map("store")

}

model Region {
  id         Int   @id @map("regionId") @default(autoincrement())
  name       String   @db.VarChar(155) @map("regionName")

  stores Store[]
}

model Review {
  id         Int  @id  @map("reviewId") @default(autoincrement())
  user       User    @relation(fields: [userId], references: [id])
  userId     Int
  store      Store   @relation(fields: [storeId], references: [id])
  storeId    Int  
  body       String  @db.Text
  //score
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.VarChar(512)
  expiresAt DateTime @map("expires_at")

  @@map("session")

  //sid라는 값을 통해 Session을 식별
  //data에는 자유롭게 사용자의 정보를 저장
  //expiresAt 을 통해 Session의 만료 시간(기본 1주일 정도) 설정
}